{
  "latex-workshop.latex.recipes": [
    { "name": "LuaLaTeX (latexmk)", "tools": ["latexmk-lualatex"] }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-lualatex",
      "command": "latexmk",
      "args": ["-lualatex", "-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-outdir=%DIR%/build", "%DOC%"]
    }
  ],
  "latex-workshop.latex.outDir": "%DIR%/build"
}
